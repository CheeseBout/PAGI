# Must match backend/.env SANDBOX_INTERNAL_TOKEN
SANDBOX_INTERNAL_TOKEN=dev-internal-token-change-me

# In-container path for Docker; for local `python main.py` on Windows/Mac
# use a relative dir instead, e.g. WORKSPACE_ROOT=./workspaces
WORKSPACE_ROOT=/workspaces
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0
SANDBOX_PIDS_LIMIT=64
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_IMAGE=pagi-sandbox:latest

# Run code as a local subprocess when the Docker daemon is unreachable.
# UNSAFE — leave "true" only for local development.
SANDBOX_SUBPROCESS_FALLBACK=true

# Dedicated network + iptables egress filter for exec containers (blocks
# RFC1918/loopback/link-local incl. 169.254.169.254, allows normal Internet).
# Linux Docker host only — degrades to "unavailable" elsewhere, see /health.
SANDBOX_EXEC_NETWORK=pagi-exec
SANDBOX_EXEC_SUBNET=172.28.0.0/16
SANDBOX_ENABLE_EGRESS_FILTER=true

# Set when mounting the host Docker socket into this service.
# DOCKER_HOST=unix:///var/run/docker.sock

# -- Concurrency + quota (Wave 1d) ----------------------------------
# Max exec containers running at once (0 = unlimited). A single session is
# also serialised so one runaway agent can't launch many execs in parallel.
SANDBOX_MAX_CONCURRENT_EXEC=4
SANDBOX_EXEC_QUEUE_TIMEOUT=0.5
# Reject writes/exec once a session workspace exceeds this (0 = unlimited).
SANDBOX_WORKSPACE_QUOTA_MB=512
