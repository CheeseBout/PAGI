# ── LLM provider API keys ─────────────────────────────────────────────
# Only the key(s) for providers you actually use are required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ── Tools ─────────────────────────────────────────────────────────────
# Enables the `web_search` tool (https://tavily.com). Leave blank to disable it.
TAVILY_API_KEY=

# ── Core ──────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/pagi.db
# Generate once: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=CHANGE_ME_dev_insecure_secret_0123456789abcdef0123456789abcdef

# ── Sandbox service ───────────────────────────────────────────────────
# In docker-compose this is http://sandbox:8000; for local dev use the mapped port.
SANDBOX_URL=http://localhost:8100
SANDBOX_INTERNAL_TOKEN=dev-internal-token-change-me

# ── Web ───────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
# Set true in production (served over HTTPS) so the session cookie is Secure.
SESSION_COOKIE_SECURE=false

# ── Chat file uploads ────────────────────────────────────────────────
MAX_UPLOAD_MB=20
UPLOAD_DIR=./data/uploads

# ── Misc ──────────────────────────────────────────────────────────────
APPROVAL_TIMEOUT_HOURS=24
LOG_LEVEL=INFO
TIMEZONE=Asia/Ho_Chi_Minh
# Pull the newest litellm model price map from the network on boot.
LITELLM_REFRESH_MODEL_COST=false

# ── Seed admin (created on first boot only, when users table is empty) ─
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# -- Reliability (Wave 2) ---------------------------------------------
# Hard cap on one unattended (cron/REST) turn. Interactive turns are bounded
# per-LLM-call instead so a slow human approval doesn't kill them.
TURN_MAX_SECONDS=900
LLM_CALL_TIMEOUT_SECONDS=300
# On boot, re-run turns whose session was still "running" this long ago.
RESUME_STALE_AFTER_SECONDS=120
RESUME_SWEEP_CONCURRENCY=4
# Cap concurrent backend->sandbox calls in flight.
SANDBOX_MAX_CONCURRENT_CALLS=6

# -- Prompt caching / context window (Wave 3) -----------------------
CONTEXT_MARGIN_TOKENS=2000
ENABLE_ROLLING_SUMMARY=true
# Model for the rolling summary; blank = reuse the conversation's own model.
SUMMARY_MODEL=

# -- Semantic memory (Wave 3) -- OFF unless EMBEDDING_MODEL is set ---
EMBEDDING_MODEL=
MEMORY_TOP_K=4
MEMORY_CROSS_SESSION=true

# -- Usage budget (Wave 5) -- 0 disables the over-budget warning ----
MONTHLY_BUDGET_USD=0

# -- Optional Redis (reserved for multi-worker; unset = in-process) -
REDIS_URL=

# -- RAG / Knowledge Base (Phase 12, SPEC §14) ---------------------
# System-wide defaults; a collection or agent overrides them without a restart.
RAG_ENABLED=true
# Embedding model for new collections. Vietnamese corpora: bge-m3 / multilingual-e5.
# Independent of EMBEDDING_MODEL (conversation memory).
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_VECTOR_STORE=sqlite_np
RAG_MAX_DOC_MB=25
RAG_MAX_CHUNKS_PER_COLLECTION=100000
RAG_INGEST_CONCURRENCY=2
RAG_ENRICH_CONCURRENCY=4
RAG_EMBED_MAX_RETRIES=3
RAG_EMBED_BATCH_SIZE=64
RAG_QUERY_LOG_RETENTION_DAYS=30
RAG_DOC_DIR=./data/kb_docs
# JSON overriding RagConfig §14.2 defaults, e.g. {"rerank_mode":"none"}
RAG_DEFAULT_CONFIG_JSON={}
